# Replace every CHANGE_ME value with a unique secret before deployment.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=smes_v2
MYSQL_USER=smes_app
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
ALTCHA_HMAC_SIGNATURE_SECRET=CHANGE_ME_USE_A_DISTINCT_32_BYTE_RANDOM_SECRET
ALTCHA_HMAC_KEY_SIGNATURE_SECRET=CHANGE_ME_USE_ANOTHER_DISTINCT_32_BYTE_RANDOM_SECRET
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
RABBITMQ_USER=smes_worker
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_VHOST=/smes
SEED_DEMO_ENABLED=false
SEED_INDUSTRY_SCENARIOS_ENABLED=false
# Required only when the corresponding seed option is enabled. Use unique passwords.
SEED_ADMIN_PASSWORD=CHANGE_ME_IF_SEEDING
SEED_DEMO_USER_PASSWORD=CHANGE_ME_IF_SEEDING
SEED_SCENARIO_PASSWORD=CHANGE_ME_IF_SEEDING
ALLOWED_ORIGINS=http://localhost:8088

# Local only by default. Behind OpenResty/SafeLine, bind to the Docker bridge gateway.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088

# Optional image source overrides; defaults are official images/mirrors.
MYSQL_IMAGE=public.ecr.aws/docker/library/mysql:8.4
NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
NGINX_IMAGE=public.ecr.aws/docker/library/nginx:stable-alpine
