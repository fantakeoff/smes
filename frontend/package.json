      "js-yaml": "4.3.2",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "path-to-regexp": "8.4.0",
      "picomatch@<2.3.2": "2.3.2",
      "postcss-selector-parser@^6.0.0": "6.1.5",
      "postcss-selector-parser@^7.0.0": "7.1.6",
      "rollup": "4.59.0",
      "svgo@<3.3.5": "3.3.5",
